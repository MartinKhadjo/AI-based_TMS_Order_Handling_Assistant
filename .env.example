DJANGO_SECRET_KEY=change-me-for-local-dev
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_TIME_ZONE=Europe/Berlin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave POSTGRES_HOST empty for local SQLite development.
# Docker Compose sets these values for the backend service.
POSTGRES_DB=tms_demo
POSTGRES_USER=tms_user
POSTGRES_PASSWORD=tms_password
POSTGRES_HOST=
POSTGRES_PORT=5432

# mock is deterministic and requires no external key.
AI_MODE=mock

VITE_API_BASE_URL=http://localhost:8000/api
